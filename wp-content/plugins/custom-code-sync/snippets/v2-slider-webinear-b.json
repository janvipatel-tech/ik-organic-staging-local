        "_elementor_code": "<!-- V2 Slider Webinear (B) -->\r\n<script>\r\n\r\n\r\n    function v2SlotSlider(mainConatiner) {\r\n        const sliderContainer = mainConatiner.querySelector(\".slots_container\");\r\n        const getLeftArrow = sliderContainer.querySelector(\".left_arrow\");\r\n        const getRightArrow = sliderContainer.querySelector(\".right_arrow\");\r\n\r\n        const slideFlid = sliderContainer.querySelector(\".slot_fild\");\r\n        const slotItems = slideFlid.querySelectorAll(\"label.slot\");\r\n\r\n        let eachTransFrom = 91;\r\n        let maxTransFrom = (eachTransFrom * slotItems.length) + ((slotItems.length - 1) * 38) - slideFlid.offsetWidth;\r\n        let currntPosi = 0;\r\n\r\n        getRightArrow.addEventListener(\"click\", function () {\r\n\r\n            eachTransFrom = slotItems[0].offsetWidth;\r\n            maxTransFrom = (eachTransFrom * slotItems.length) + ((slotItems.length - 1) * 38) - slideFlid.offsetWidth;\r\n\r\n            currntPosi = currntPosi + eachTransFrom + 19;\r\n            if (currntPosi >= maxTransFrom) {\r\n                currntPosi = maxTransFrom;\r\n                getRightArrow.setAttribute(\"ac_status\", false);\r\n            }\r\n            if (currntPosi > 0) {\r\n                getLeftArrow.setAttribute(\"ac_status\", true);\r\n            }\r\n            if (currntPosi < 0) currntPosi = 0;\r\n            slideFlid.style.transform = `translateX(-${currntPosi}px)`;\r\n        })\r\n\r\n        getLeftArrow.addEventListener(\"click\", function () {\r\n            currntPosi = currntPosi - eachTransFrom - 19;\r\n            if (currntPosi <= 0) {\r\n                currntPosi = 0;\r\n                getLeftArrow.setAttribute(\"ac_status\", false);\r\n            }\r\n            if (currntPosi < maxTransFrom) {\r\n                getRightArrow.setAttribute(\"ac_status\", true);\r\n            }\r\n            slideFlid.style.transform = `translateX(-${currntPosi}px)`;\r\n        })\r\n    }\